    },
    "sections": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "양식의 구역 key(지침에 적힌 영문 key 그대로)"
          },
          "body": {
            "type": "string",
            "description": "문단(없으면 빈 문자열)"
          },
          "bullets": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "목록 항목 한 줄씩(없으면 빈 배열)"
          }
        },
        "required": [
          "key",
          "body",
          "bullets"
        ],
        "additionalProperties": false
