{
  "type": "object",
  "properties": {
    "headline": {
      "type": "string",
      "description": "포트폴리오 첫머리 한 줄(어떤 문제를 어떻게 푸는 사람인지)"
    },
    "coreSkills": {
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "string"
      },
