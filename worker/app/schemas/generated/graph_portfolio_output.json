      "description": "양식의 최상위 구역(프로젝트 앞·뒤, 지침 순서대로)"
    },
    "projects": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
