# deploy/agent/.env 로 복사해 값을 채운다(cp .env.example .env && chmod 600 .env). 값은 git에 올리지 않는다.
# 실행기는 Vercel 운영 배포와 "같은 앱"이므로, Vercel Production 환경 변수(.env.production.example의 항목)를 그대로 넣는다.
# VERCEL로 시작하는 변수는 넣지 않는다(넣으면 Vercel 배포로 인식해 한 호출 예산이 5분으로 줄어든다).
APP_ENV=PRODUCTION
APP_URL=
DATABASE_URL=
DIRECT_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 같은 맥미니의 그래프에는 도커 네트워크로 붙는다(인증서 이름이 도메인이라 +ssc): bolt+ssc://careerloop-graph:7687
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
ADMIN_EMAILS=

# --- 에이전트 실행기 ---
# Vercel과 같은 값(32자 이상, `openssl rand -hex 32`). Vercel이 보낸 서명 호출을 이 값으로 확인한다.
RESUME_AGENT_CHAIN_SECRET=
# (선택) 실행기가 동시에 실행하는 작업 수(전 사용자 합계, 1~16). 기본 3.
RESUME_AGENT_RUNNER_CONCURRENCY=
# (선택) Vercel과 같게 맞출 에이전트 설정: RESUME_AGENT, RESUME_AGENT_PIPELINE, RESUME_AGENT_PARALLEL, RESUME_AGENT_MAX_REVISIONS 등
