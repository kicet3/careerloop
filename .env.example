# Claude API 키. 비워두면 Claude API 엔진이 선택지에서 빠진다(계정 로그인 엔진만 사용).
ANTHROPIC_API_KEY=
# 기본 모델 (기본값 claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# 1이면 개발용 mock만 쓴다(키 없이 UI 확인). MOCK_DELAY_MS는 mock 단계당 지연(ms, 비우면 400)
LLM_MOCK=
MOCK_DELAY_MS=

# (임시·개인용) API 키 대신 Claude 구독 계정·ChatGPT 계정으로 로그인해 쓰는 CLI 엔진. 1이면 켠다.
# 서버 PC에 Claude Code(claude)·Codex CLI(codex)가 있어야 하고, 웹의 'AI 연결' 화면에서 로그인한다.
CLI_PROVIDERS=
# 로그인 정보 저장 폴더(기본 ./data/providers). "system"이면 이 PC의 기본 CLI 로그인을 그대로 쓴다(웹에서 로그인·로그아웃 불가).
CLAUDE_CLI_CONFIG_DIR=
CODEX_CLI_HOME=
# CLI 엔진 모델. 비우면 Claude는 claude-opus-5-5, Codex는 codex 설정의 기본 모델
CLAUDE_CLI_MODEL=
CODEX_CLI_MODEL=

# 로컬은 SQLite 파일, 배포는 Turso(libsql://...) + 토큰
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# 사용자당 하루 진단 횟수 제한
DAILY_DIAGNOSIS_LIMIT=5

# (선택) 리버스 프록시 뒤에서 same-origin 검사에 쓸 공개 URL. 예: https://resume-panel.example.com
APP_URL=

# (선택) 개발 서버(next dev)를 localhost 밖 주소로 열 때 허용할 호스트명(쉼표 구분, 스킴·포트 없이).
# Tailscale MagicDNS(*.ts.net)는 기본 허용. 예: tailnet IP로 열 때 100.x.y.z
DEV_ALLOWED_ORIGINS=
