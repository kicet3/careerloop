# Claude API 키. 비워두면(또는 LLM_MOCK=1) 가짜 심사위원(mock)으로 동작해 UI를 키 없이 확인할 수 있다.
ANTHROPIC_API_KEY=
# 기본 모델 (기본값 claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
LLM_MOCK=

# 로컬은 SQLite 파일, 배포는 Turso(libsql://...) + 토큰
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# 사용자당 하루 진단 횟수 제한
DAILY_DIAGNOSIS_LIMIT=5
