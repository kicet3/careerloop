# 배포 모드: DEV(기본, 비우면 DEV — 단 Vercel Production 배포는 PRODUCTION) | PRODUCTION.
# PRODUCTION은 필수 설정(APP_URL https·DATABASE_URL(+Turso 토큰)·NEO4J_*·R2_*·GOOGLE_CLIENT_ID·GOOGLE_CLIENT_SECRET·AI 엔진)이
# 모두 있어야 서버가 뜨고, 세션 쿠키 Secure 강제·저장소 R2 필수·CLI 엔진 기본 끔·Origin 검사는 앱 주소 호스트만 허용한다.
#
# Vercel(README '배포 (Vercel + Turso)'):
# - Production 범위: APP_ENV=PRODUCTION · APP_URL · DATABASE_URL/DATABASE_AUTH_TOKEN · NEO4J_* · R2_* · ANTHROPIC_API_KEY · GOOGLE_*
# - Preview 범위: 운영과 다른 DB·버킷·그래프(또는 Preview 배포 끄기). 운영 비밀을 '모든 환경'으로 넣지 말 것.
# - CLI 엔진은 Vercel에서 항상 꺼진다(ANTHROPIC_API_KEY 필수). 빠진 필수 값은 Vercel 빌드가 실패하며 알려 준다.
APP_ENV=DEV

# Claude API 키. 비워두면 Claude API 엔진이 선택지에서 빠진다(계정 로그인 엔진만 사용).
ANTHROPIC_API_KEY=
# 기본 모델 (기본값 claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# (임시·개인용) API 키 대신 Claude 구독 계정·ChatGPT 계정으로 로그인해 쓰는 CLI 엔진. 1이면 켠다(Vercel에서는 무시).
# 서버 PC에 Claude Code(claude)·Codex CLI(codex)가 있어야 하고, 웹의 'AI 연결' 화면에서 로그인한다.
CLI_PROVIDERS=
# APP_ENV=PRODUCTION에서도 CLI 엔진을 켜려면 1(기본은 꺼짐 — 가입한 모든 사용자가 서버 계정의 구독을 쓰게 된다)
CLI_PROVIDERS_IN_PRODUCTION=
# 로그인 정보 저장 폴더(기본 ./data/providers). "system"이면 이 PC의 기본 CLI 로그인을 그대로 쓴다(웹에서 로그인·로그아웃 불가).
CLAUDE_CLI_CONFIG_DIR=
CODEX_CLI_HOME=
# CLI 엔진 모델. 비우면 Claude는 claude-opus-5-5, Codex는 codex 설정의 기본 모델
CLAUDE_CLI_MODEL=
CODEX_CLI_MODEL=

# 로컬은 SQLite 파일, 배포는 Turso(libsql://...) + 토큰. Vercel에서는 file: 불가.
# 비우면 Vercel Turso 연동이 넣는 TURSO_DATABASE_URL·TURSO_AUTH_TOKEN을 쓴다.
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=
# (Vercel) 마이그레이션은 Production 빌드 때 한 번 적용한다(scripts/migrate.mjs). Preview 전용 DB면 Preview 범위에 1.
MIGRATE_ON_BUILD=
# (Vercel, 비상용) 1이면 빌드 대신 런타임 첫 요청에 마이그레이션을 적용한다(빌드에서 DB에 닿을 수 없을 때).
DB_MIGRATE_AT_RUNTIME=

# 사용자당 하루 진단 횟수 제한
DAILY_DIAGNOSIS_LIMIT=5
# (선택) 사용자당 24시간 심사위원 대화 메시지 수. 비우면 100
REVIEWER_CHAT_DAILY_LIMIT=
# (선택) 백그라운드 진단의 시간 예산(초). Vercel 기본은 maxDuration(300) - 30 = 270이고 그보다 크게 줘도 270에서 멈춘다
# (멈춘 진단은 진행 화면이 자동으로 이어서 실행). 자체 호스팅 기본은 제한 없음.
DIAGNOSIS_TIME_BUDGET_SEC=

# 공개 URL. 예: https://careerloop.example.com
# DEV는 (선택) 리버스 프록시 뒤 same-origin 검사에 함께 허용. PRODUCTION은 필수(https)이고 이 호스트만 허용한다.
# Vercel에서 비우면 Production은 https://$VERCEL_PROJECT_PRODUCTION_URL, Preview는 https://$VERCEL_BRANCH_URL.
APP_URL=

# (선택) 개발 서버(next dev)를 localhost 밖 주소로 열 때 허용할 호스트명(쉼표 구분, 스킴·포트 없이).
# Tailscale MagicDNS(*.ts.net)는 기본 허용. 예: tailnet IP로 열 때 100.x.y.z
DEV_ALLOWED_ORIGINS=

# (선택, 자체 호스팅) X-Forwarded-For를 덧붙이는 우리 쪽 프록시 수. 레이트 리밋의 클라이언트 IP를 이 값으로 정한다.
# 프록시가 여러 단(예: CDN → 로드밸런서)이면 그 수를 넣는다. 비우면 기본값.
TRUSTED_PROXY_HOPS=

# (선택) 경력 그래프 저장소 Neo4j. NEO4J_URI를 비우면 '경력 그래프' 화면이 안내만 보이고 그래프 API는 503이다.
# 개발용은 docker compose up -d neo4j (docker-compose.yml, NEO4J_PASSWORD를 .env.local에 두고 --env-file .env.local) 뒤
# 아래 세 값을 채운다. 예: NEO4J_URI=bolt://127.0.0.1:7687, NEO4J_USER=neo4j
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
# (선택) 데이터베이스 이름. 비우면 서버 기본값(community는 neo4j)
NEO4J_DATABASE=

# (선택) 회사별 이력서 본문 저장소 Cloudflare R2(S3 호환). 네 값이 모두 있으면 R2, 하나라도 비면 로컬 파일(STORAGE_DIR).
# R2 대시보드 → R2 → API 토큰 관리에서 '객체 읽기·쓰기' 토큰을 해당 버킷으로 제한해 만든다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# (선택) 엔드포인트 직접 지정(기본 https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com, 관할 구역 버킷이면 .eu. 등)
R2_ENDPOINT=
# 로컬 파일 저장소 폴더(기본 ./data/storage). R2를 쓰면 무시한다.
STORAGE_DIR=

# Google 로그인(OAuth 2.0 / OpenID Connect). Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션).
# 승인된 리디렉션 URI: <접속 주소>/api/auth/google/callback (예: http://localhost:3000/api/auth/google/callback,
# 배포: https://<운영 도메인>/api/auth/google/callback). IP 주소는 Google이 허용하지 않는다.
# PRODUCTION은 필수. DEV에서 비우면 Google 로그인 버튼이 비활성화된다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (선택, DEV 전용) 리디렉션 URI의 origin 고정. 비우면 APP_URL, 그것도 없으면 접속한 주소(localhost·*.ts.net·DEV_ALLOWED_ORIGINS만).
# 예: https://dev-machine.example-tailnet.ts.net:9470. PRODUCTION은 항상 APP_URL을 쓴다.
GOOGLE_REDIRECT_ORIGIN=
