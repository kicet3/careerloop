// CareerLoop DB 스키마(PostgreSQL — 운영은 Supabase, 로컬은 docker compose postgres, 테스트는 PGlite).
// 테이블·컬럼 이름은 예전 SQLite(Drizzle) 스키마의 snake_case를 그대로 쓴다(@@map/@map).
// 접속 주소는 prisma.config.ts(마이그레이션)와 src/lib/db/client.ts(런타임, PrismaPg 어댑터)가 정한다.
// 상태·종류 문자열은 DB enum 대신 text로 두고, 허용 값은 src/lib/domain/*의 zod·TS 유니온이 정한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  email           String    @unique(map: "users_email_unique")
  name            String?
  /// 예전 이메일·비밀번호 가입 계정의 해시. Google 계정은 null.
  passwordHash    String?   @map("password_hash")
  /// Google 계정 고유 ID(id_token의 sub). Google 로그인을 연결하지 않았으면 null.
  googleSub       String?   @unique(map: "users_google_sub_unique") @map("google_sub")
  /// UserRole('user' | 'admin', src/lib/domain/users.ts). ADMIN_EMAILS에 있는 이메일은 로그인·세션 확인 때 admin으로 올린다.
  role            String    @default("user")
  /// UserStatus('pending' | 'approved' | 'rejected' | 'suspended'). 새 가입은 pending — 승인 전에는 앱·비용 API를 쓸 수 없다.
  status          String    @default("pending")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  /// 승인한 관리자 id(또는 'system:admin_emails'·'system:migration'). FK 없음 — 관리자가 탈퇴해도 기록은 남는다.
  approvedBy      String?   @map("approved_by")
  statusChangedAt DateTime? @map("status_changed_at") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions          Session[]
  consents          UserConsent[]
  sharedPostings    SharedPosting[]
  jobPostings       JobPosting[]
  postingImports    PostingImport[]
  diagnoses         Diagnosis[]
  diagnosisRuns     DiagnosisRun[]
  chatThreads       ChatThread[]
  companyResumes    CompanyResume[]
  applications      Application[]
  interviewSessions InterviewSession[]
  interviewAnswers  InterviewAnswer[]
  portfolios        Portfolio[]
  llmUsageEvents    LlmUsageEvent[]
  mcpTokens         McpToken[]

  @@index([status, createdAt], map: "users_status_idx")
  @@map("users")
}

/// 세션 토큰 원문은 쿠키에만 있고, DB에는 SHA-256 해시를 id로 저장한다.
model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "sessions_user_id_fkey")

  @@index([userId], map: "sessions_user_idx")
  @@map("sessions")
}

/// 약관·개인정보 안내 확인·만 14세 확인·마케팅 수신 동의 기록(append-only). 현재 상태는 (user, type)별 최신 행.
/// 문서 버전이 바뀌면(src/lib/legal/consents.ts) 필수 항목을 다시 받는다. 탈퇴하면 함께 지워진다(CASCADE).
model UserConsent {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  /// ConsentType
  type      String
  /// 동의한 문서 버전(CONSENT_DOCS[type].version).
  version   String
  agreed    Boolean
  /// ConsentSource('signup' | 'gate' | 'account')
  source    String
  /// HMAC-SHA256(ip) 앞 32자. 원문 IP는 저장하지 않는다.
  ipHash    String?  @map("ip_hash")
  /// User-Agent 앞 200자.
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_consents_user_id_fkey")

  @@index([userId, type, createdAt], map: "user_consents_user_idx")
  @@map("user_consents")
}

/// 채용 공고 보관함. 같은 사용자 안에서 정규화 URL(url_key)은 유일하다(URL 없는 공고는 url_key null이라 여러 개 가능).
/// 마감은 KST 날짜·시각 문자열(domain/postings.ts).
model JobPosting {
  id                String   @id
  userId            String   @map("user_id")
  company           String
  roleTitle         String   @map("role_title")
  url               String?
  /// normalizeUrl(url). 중복 판별용.
  urlKey            String?  @map("url_key")
  platform          String?
  /// PostingStatus
  status            String   @default("saved")
  /// JD 텍스트(≤30000자). 진단·이력서·경력 대조가 읽는다. URL 가져오기는 구조(structured)를 제목 붙은 구역 텍스트로 조합해 둔다.
  jdText            String?  @map("jd_text")
  /// PostingStructure(jsonb, src/lib/domain/posting-structure.ts). null이면 아직 없음(화면은 jdText를 정규식으로 즉석 구조화).
  structured        Json?
  structuredVersion Int?     @map("structured_version")
  /// 가져온 페이지 본문 원문(≤30000자). 직접 입력은 null(jdText가 원문).
  sourceText        String?  @map("source_text")
  /// 'YYYY-MM-DD'(KST).
  deadline          String?
  /// 'HH:mm'(KST). 날짜만 있으면 null.
  deadlineTime      String?  @map("deadline_time")
  /// DeadlineKind
  deadlineKind      String   @default("unspecified") @map("deadline_kind")
  /// EmploymentType
  employmentType    String   @default("unknown") @map("employment_type")
  /// WorkType
  workType          String   @default("unknown") @map("work_type")
  location          String?
  /// CareerLevel
  careerLevel       String   @default("unknown") @map("career_level")
  note              String?
  /// 'manual' 또는 AI 추출 엔진(ProviderId).
  extractedBy       String   @default("manual") @map("extracted_by")
  /// 공용 공고 id. 공용 공고가 먼저 만들어지고 보관 공고가 그것을 가리킨다(URL 가져오기·공고 찾기·직접 입력 모두).
  /// 공용 공고는 지우지 않으므로 사실상 항상 있다(예전 FK 규칙 SET NULL은 그대로).
  sharedPostingId   String?  @map("shared_posting_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "job_postings_user_id_fkey")
  sharedPosting     SharedPosting?     @relation(fields: [sharedPostingId], references: [id], onDelete: SetNull, map: "job_postings_shared_posting_id_fkey")
  postingImports    PostingImport[]
  diagnoses         Diagnosis[]
  companyResumes    CompanyResume[]
  applications      Application[]
  interviewSessions InterviewSession[]

  @@unique([userId, urlKey], map: "job_postings_url_uq")
  @@index([userId, updatedAt], map: "job_postings_user_idx")
  @@index([sharedPostingId], map: "job_postings_shared_idx")
  @@map("job_postings")
}

/// 공용 공고(공고 찾기). URL 가져오기 결과만 정규화 URL(url_key)당 한 행으로 모은다 — 승인된 모든 사용자가 본다.
/// 공고 페이지에서 뽑은 값만 둔다. 개인 메모·상태·지원 기록·직접 입력 공고는 job_postings에만 있다(공유하지 않는다).
/// 같은 URL을 다시 가져오면 LLM을 부르지 않고 이 행을 복사한다. '다시 가져오기'(refresh)만 페이지를 다시 읽어 이 행을 갱신한다.
model SharedPosting {
  id                String    @id
  /// normalizeUrl(url). 전역 유일. 직접 입력으로 만든 공용 공고는 null(URL로 다시 쓰지 않는다 — NULL은 여러 개 허용).
  urlKey            String?   @unique(map: "shared_postings_url_key_unique") @map("url_key")
  /// 최종(리다이렉트 뒤) 주소. 직접 입력으로 만든 공용 공고는 null.
  url               String?
  platform          String?
  company           String
  roleTitle         String    @map("role_title")
  /// composeJdText(structured) 또는 추출 JD(≤30000자).
  jdText            String?   @map("jd_text")
  /// PostingStructure(jsonb).
  structured        Json?
  structuredVersion Int?      @map("structured_version")
  /// 가져온 페이지 본문(≤30000자).
  sourceText        String?   @map("source_text")
  deadline          String?
  deadlineTime      String?   @map("deadline_time")
  deadlineKind      String    @default("unspecified") @map("deadline_kind")
  employmentType    String    @default("unknown") @map("employment_type")
  workType          String    @default("unknown") @map("work_type")
  location          String?
  careerLevel       String    @default("unknown") @map("career_level")
  /// AI 추출 엔진(ProviderId). 직접 입력으로 만든 공용 공고는 'manual'.
  extractedBy       String    @map("extracted_by")
  /// 이 공고를 보관함에 둔 사용자 수(job_postings.shared_posting_id 개수). refreshSharedImporterCount가 다시 센다.
  importerCount     Int       @default(0) @map("importer_count")
  /// 처음 가져온(또는 직접 입력한) 사용자(관리·남용 대응·직접 입력 공고 동기화용, 화면에 내보내지 않는다). 탈퇴하면 null.
  createdBy         String?   @map("created_by")
  /// 관리자가 공고 찾기에서 숨긴 시각(개인 페이지·비공개 링크 등). 숨긴 공고는 목록·재사용에서 빠진다.
  hiddenAt          DateTime? @map("hidden_at") @db.Timestamptz(3)
  /// 페이지를 마지막으로 읽은 시각.
  fetchedAt         DateTime  @map("fetched_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  // 원문 페이지 전체 캡처(src/lib/postings/capture-store.ts, domain/posting-capture.ts). 가져오기와 따로(after()) 찍는다.
  /// PostingCaptureStatus('pending' | 'running' | 'done' | 'failed'). null이면 아직 요청한 적 없음(예전 행).
  captureStatus    String?   @map("capture_status")
  /// 저장소 키 shared-postings/<id>/capture.webp(또는 .jpg). 성공했을 때만.
  captureKey       String?   @map("capture_key")
  /// 'image/webp' | 'image/jpeg'
  captureMime      String?   @map("capture_mime")
  captureBytes     Int?      @map("capture_bytes")
  captureWidth     Int?      @map("capture_width")
  captureHeight    Int?      @map("capture_height")
  /// 마지막으로 성공한 캡처 시각.
  capturedAt       DateTime? @map("captured_at") @db.Timestamptz(3)
  /// 사용자에게 보여도 되는 한국어 실패 문구(내부 주소·스택 없음).
  captureError     String?   @map("capture_error")
  /// 지금까지 시도한 횟수(성공하면 0으로).
  captureAttempts  Int       @default(0) @map("capture_attempts")
  /// 마지막으로 pending/running이 된 시각(멈춘 작업 판별).
  captureStartedAt DateTime? @map("capture_started_at") @db.Timestamptz(3)

  creator        User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull, map: "shared_postings_created_by_fkey")
  jobPostings    JobPosting[]
  postingImports PostingImport[]

  @@index([fetchedAt], map: "shared_postings_fetched_idx")
  @@map("shared_postings")
}

/// 공고 URL 가져오기 작업. 하루 가져오기 제한은 이 표의 최근 24시간 행 수로 센다.
model PostingImport {
  id              String   @id
  userId          String   @map("user_id")
  url             String
  /// PostingImportStatus
  status          String   @default("queued")
  /// 사용자에게 보여도 되는 한국어 오류 문구.
  error           String?
  postingId       String?  @map("posting_id")
  attempts        Int      @default(0)
  /// normalizeUrl(url). 진행 중 작업 재사용·공용 공고 조회용. 예전 행은 null.
  urlKey          String?  @map("url_key")
  /// true면 '다시 가져오기': 공용 공고가 있어도 페이지를 다시 읽고 공용 공고·내 공고를 갱신한다.
  refresh         Boolean  @default(false)
  /// 결과 공용 공고(재사용했거나 새로 만든 것).
  sharedPostingId String?  @map("shared_posting_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "posting_imports_user_id_fkey")
  posting       JobPosting?    @relation(fields: [postingId], references: [id], onDelete: SetNull, map: "posting_imports_posting_id_fkey")
  sharedPosting SharedPosting? @relation(fields: [sharedPostingId], references: [id], onDelete: SetNull, map: "posting_imports_shared_posting_id_fkey")

  @@index([userId, createdAt], map: "posting_imports_user_idx")
  @@map("posting_imports")
}

model Diagnosis {
  id                String    @id
  userId            String    @map("user_id")
  title             String
  targetRole        String    @map("target_role")
  /// Situation
  situation         String
  notes             String?
  jdText            String?   @map("jd_text")
  resumeText        String    @map("resume_text")
  resumeFileName    String?   @map("resume_file_name")
  /// 포트폴리오 본문(파일에서 뽑은 텍스트 + 텍스트/URL 메모).
  portfolioText     String?   @map("portfolio_text")
  portfolioFileName String?   @map("portfolio_file_name")
  /// 이 진단에 쓴 보관 공고. 공고를 지우면 null(진단의 JD 사본은 jdText에 남는다).
  postingId         String?   @map("posting_id")
  /// DiagnosisStatus
  status            String    @default("queued")
  error             String?
  /// 공개 공유 링크 토큰. null이면 비공개.
  shareToken        String?   @unique(map: "diagnoses_share_token_unique") @map("share_token")
  model             String
  /// ProviderId. 예전 행은 null(model로 추정).
  provider          String?
  /// 현재 실행(run)의 식별자. 실행 중 모든 쓰기를 이 값으로 조건 건다.
  runId             String?   @map("run_id")
  /// 누적 토큰 사용량 UsageTotals { inputTokens, outputTokens, cacheReadTokens, cacheWriteTokens }
  usage             Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "diagnoses_user_id_fkey")
  posting      JobPosting?      @relation(fields: [postingId], references: [id], onDelete: SetNull, map: "diagnoses_posting_id_fkey")
  stages       DiagnosisStage[]
  chatThreads  ChatThread[]
  applications Application[]

  @@index([userId, createdAt], map: "diagnoses_user_idx")
  @@index([postingId], map: "diagnoses_posting_idx")
  @@map("diagnoses")
}

model DiagnosisStage {
  id          Int       @id @default(autoincrement())
  diagnosisId String    @map("diagnosis_id")
  /// StageKey
  stage       String
  /// StageStatus
  status      String    @default("pending")
  /// STAGE_SCHEMAS[stage]를 통과한 JSON.
  output      Json?
  error       String?
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade, map: "diagnosis_stages_diagnosis_id_fkey")

  @@unique([diagnosisId, stage], map: "diagnosis_stage_uq")
  @@map("diagnosis_stages")
}

/// 진단 실행 원장(append-only). 하루 제한·재시도 횟수는 이 표로 센다 — 진단을 삭제해도 줄어들지 않는다(diagnosisId에 FK 없음).
model DiagnosisRun {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  diagnosisId String   @map("diagnosis_id")
  /// 'create' | 'retry' | 'continue'
  kind        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "diagnosis_runs_user_id_fkey")

  @@index([userId, createdAt], map: "diagnosis_runs_user_idx")
  @@index([diagnosisId], map: "diagnosis_runs_diag_idx")
  @@map("diagnosis_runs")
}

/// 채팅 스레드. kind='graph'는 경력 그래프 채팅, kind='reviewer'는 완료된 진단의 심사위원 한 명과의 대화(diagnosisId·reviewer 필수).
model ChatThread {
  id          String   @id
  userId      String   @map("user_id")
  /// ChatThreadKind
  kind        String
  diagnosisId String?  @map("diagnosis_id")
  /// ReviewerId
  reviewer    String?
  title       String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "chat_threads_user_id_fkey")
  diagnosis Diagnosis?    @relation(fields: [diagnosisId], references: [id], onDelete: Cascade, map: "chat_threads_diagnosis_id_fkey")
  messages  ChatMessage[]

  @@index([userId, kind, updatedAt], map: "chat_threads_user_idx")
  @@index([diagnosisId, reviewer], map: "chat_threads_diag_idx")
  @@map("chat_threads")
}

model ChatMessage {
  id        String   @id
  threadId  String   @map("thread_id")
  /// ChatRole
  role      String
  content   String
  /// 구조화 부가 정보 — domain/chat.ts ChatMessageDataSchema.
  data      Json?
  /// ChatMessageStatus(proposed/applied/dismissed/failed). 일반 메시지는 null.
  status    String?
  /// UsageTotals
  usage     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade, map: "chat_messages_thread_id_fkey")

  @@index([threadId, createdAt], map: "chat_messages_thread_idx")
  @@map("chat_messages")
}

/// 이력서. kind='company'는 지원처(공고)별, kind='general'은 회사 지정 없는 공용(마스터) 이력서(company·roleTitle 빈 문자열, postingId null).
/// 본문은 버전별로 오브젝트 저장소에 JSON으로 두고 여기에는 메타데이터만 둔다.
model CompanyResume {
  id               String   @id
  userId           String   @map("user_id")
  /// ResumeKind('company' | 'general')
  kind             String   @default("company")
  /// 공용 이력서는 ''.
  company          String   @default("")
  /// 공용 이력서는 ''(또는 사용자가 적은 희망 직무).
  roleTitle        String   @default("") @map("role_title")
  jdText           String?  @map("jd_text")
  /// 이 이력서를 만든 보관 공고. 공고를 지우면 null.
  postingId        String?  @map("posting_id")
  /// ResumeTemplateId
  templateId       String   @map("template_id")
  title            String
  /// 현재 버전(resume_versions.id). FK는 순환을 피하려고 걸지 않는다.
  currentVersionId String?  @map("current_version_id")
  /// 복제·'공용 이력서 내용으로 시작'의 원본 이력서. 원본을 지우면 null.
  sourceResumeId   String?  @map("source_resume_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  /// ResumeApplyStatus('draft' 지원 전 | 'applying' 지원 중 | 'submitted' 지원 완료). 공용 이력서(kind='general')는 null.
  applyStatus            String?   @map("apply_status")
  applyStatusChangedAt   DateTime? @map("apply_status_changed_at") @db.Timestamptz(3)
  /// '지원 완료'로 바꿀 때 만들거나 연결한 지원 기록. 되돌리기·화면 링크용. 지원을 지우면 null.
  submittedApplicationId String?   @map("submitted_application_id")

  /// 첨부 포트폴리오(이력서당 하나, 포트폴리오 보관함 portfolios의 항목). 포트폴리오를 지우면 null.
  portfolioId            String?   @map("portfolio_id")

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "company_resumes_user_id_fkey")
  posting              JobPosting?        @relation(fields: [postingId], references: [id], onDelete: SetNull, map: "company_resumes_posting_id_fkey")
  sourceResume         CompanyResume?     @relation("ResumeCopies", fields: [sourceResumeId], references: [id], onDelete: SetNull, map: "company_resumes_source_resume_id_fkey")
  copies               CompanyResume[]    @relation("ResumeCopies")
  versions             ResumeVersion[]
  applications         Application[]      @relation("ApplicationResume")
  submittedApplication Application?       @relation("ResumeSubmittedApplication", fields: [submittedApplicationId], references: [id], onDelete: SetNull, map: "company_resumes_submitted_application_id_fkey")
  portfolio            Portfolio?         @relation(fields: [portfolioId], references: [id], onDelete: SetNull, map: "company_resumes_portfolio_id_fkey")
  interviewSessions    InterviewSession[]

  @@index([userId, applyStatus, updatedAt], map: "company_resumes_user_status_idx")
  @@index([userId, kind, updatedAt], map: "company_resumes_user_kind_idx")
  @@index([userId, updatedAt], map: "company_resumes_user_idx")
  @@index([postingId], map: "company_resumes_posting_idx")
  @@index([portfolioId], map: "company_resumes_portfolio_idx")
  @@map("company_resumes")
}

/// 포트폴리오 보관함(개수 제한 없음). 이력서는 이 중 하나를 첨부한다(company_resumes.portfolio_id).
/// 파일은 원본을 보관하지 않고 뽑은 텍스트만 저장소에 둔다. URL은 주소만 저장한다(서버가 열지 않는다).
model Portfolio {
  id          String   @id
  userId      String   @map("user_id")
  /// 목록에 보일 이름(120자 이내).
  title       String
  /// 사용자가 적은 역할·결과 메모(2000자 이내). 면접 질문·진단에 포트폴리오와 함께 넘어간다.
  description String?
  /// PortfolioKind('file' | 'url')
  kind        String
  /// 올린 파일 이름(kind='file').
  fileName    String?  @map("file_name")
  /// 포트폴리오 주소(kind='url', http/https만).
  url         String?
  /// 뽑은 텍스트의 저장소 키 users/<u>/portfolios/<id>/text-<꼬리>.txt(kind='file'). 예전 이력서 첨부에서 옮긴 항목은
  /// users/<u>/resumes/<이력서 id>/portfolio-<꼬리>.txt를 그대로 쓴다(이력서를 지울 때 이 키는 남긴다).
  textKey     String?  @map("text_key")
  /// 뽑은 텍스트 글자 수(kind='file').
  chars       Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "portfolios_user_id_fkey")
  resumes CompanyResume[]

  @@index([userId, updatedAt], map: "portfolios_user_idx")
  @@map("portfolios")
}

model ResumeVersion {
  id         String   @id
  resumeId   String   @map("resume_id")
  versionNo  Int      @map("version_no")
  /// 저장소 키(users/<userId>/resumes/<resumeId>/...). 본문은 ResumeDocument JSON.
  storageKey String   @map("storage_key")
  note       String?
  /// ResumeVersionSource
  source     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  resume CompanyResume @relation(fields: [resumeId], references: [id], onDelete: Cascade, map: "resume_versions_resume_id_fkey")

  @@unique([resumeId, versionNo], map: "resume_versions_no_uq")
  @@map("resume_versions")
}

/// 지원 기록. 공고·이력서·진단과 느슨하게 연결한다(원본을 지우면 FK는 null, 기록은 남는다).
/// resumeVersionId에는 FK를 걸지 않는다: 이력서를 지워도 버전별 성과 집계가 유지되게.
model Application {
  id              String   @id
  userId          String   @map("user_id")
  postingId       String?  @map("posting_id")
  company         String
  roleTitle       String   @map("role_title")
  /// ApplicationStage
  stage           String   @default("applied")
  /// 'YYYY-MM-DD'(KST).
  appliedAt       String?  @map("applied_at")
  nextStep        String?  @map("next_step")
  /// 'YYYY-MM-DD'(KST).
  nextDate        String?  @map("next_date")
  note            String?
  favorite        Boolean  @default(false)
  resumeId        String?  @map("resume_id")
  resumeVersionId String?  @map("resume_version_id")
  /// 지원 시점의 이력서 표시 이름(예: "토스 백엔드 · v3").
  resumeLabel     String?  @map("resume_label")
  /// 제출 사본 저장소 키(users/<u>/applications/<id>/submitted.json).
  submittedKey    String?  @map("submitted_key")
  diagnosisId     String?  @map("diagnosis_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "applications_user_id_fkey")
  posting      JobPosting?        @relation(fields: [postingId], references: [id], onDelete: SetNull, map: "applications_posting_id_fkey")
  resume       CompanyResume?     @relation("ApplicationResume", fields: [resumeId], references: [id], onDelete: SetNull, map: "applications_resume_id_fkey")
  diagnosis    Diagnosis?         @relation(fields: [diagnosisId], references: [id], onDelete: SetNull, map: "applications_diagnosis_id_fkey")
  events       ApplicationEvent[]
  /// 이 지원을 '지원 완료' 기록으로 가리키는 이력서(보통 0~1개).
  submittedFor CompanyResume[]    @relation("ResumeSubmittedApplication")

  @@index([userId, updatedAt], map: "applications_user_idx")
  @@index([postingId], map: "applications_posting_idx")
  @@map("applications")
}

/// 지원 단계 변경 이력(append-only). 단계를 바꾸는 같은 트랜잭션에서 쓴다.
model ApplicationEvent {
  id            Int      @id @default(autoincrement())
  applicationId String   @map("application_id")
  /// ApplicationStage. 처음 만들 때는 null.
  fromStage     String?  @map("from_stage")
  /// ApplicationStage
  toStage       String   @map("to_stage")
  note          String?
  at            DateTime @default(now()) @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade, map: "application_events_application_id_fkey")

  @@index([applicationId, at], map: "application_events_app_idx")
  @@map("application_events")
}

/// 면접 연습 세션: 이력서 하나(+ 첨부 포트폴리오, + 연결 공고)로 만든 예상 질문 묶음. src/lib/interview/*.
/// 생성에 쓴 자료(이력서 줄·포트폴리오·JD)는 저장소 스냅숏(sourceKey)에 고정한다 — 원본 이력서를 고치거나 지워도 인용이 유지된다.
model InterviewSession {
  id              String    @id
  userId          String    @map("user_id")
  /// 원본 이력서. 지우면 null(세션·스냅숏은 남는다).
  resumeId        String?   @map("resume_id")
  /// 생성에 쓴 이력서 버전(resume_versions.id). FK 없음.
  resumeVersionId String?   @map("resume_version_id")
  /// 생성에 쓴 보관 공고. 지우면 null.
  postingId       String?   @map("posting_id")
  title           String
  /// 생성 당시 이력서 표시 이름(예: "토스 백엔드 · v3").
  resumeLabel     String    @map("resume_label")
  /// 생성 당시 "회사 · 직무"(공고·지원처 이력서). 공용 이력서에 공고가 없으면 null(직무 일반 질문).
  targetLabel     String?   @map("target_label")
  hasPortfolio    Boolean   @default(false) @map("has_portfolio")
  hasPosting      Boolean   @default(false) @map("has_posting")
  /// InterviewSessionStatus('generating' | 'ready' | 'failed')
  status          String    @default("generating")
  error           String?
  /// 현재 생성 실행 식별자(재시도 경쟁 방지 — 이 값이 같을 때만 결과를 쓴다).
  runId           String?   @map("run_id")
  /// ProviderId
  provider        String?
  model           String?
  /// 스냅숏 저장소 키 users/<u>/interview/<id>/source.json(InterviewSourceSnapshot).
  sourceKey       String?   @map("source_key")
  questionCount   Int       @default(0) @map("question_count")
  /// 답변을 한 번 이상 한 질문 수(진행률).
  answeredCount   Int       @default(0) @map("answered_count")
  /// UsageTotals(생성 + 피드백 누적)
  usage           Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  generatedAt     DateTime? @map("generated_at") @db.Timestamptz(3)

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "interview_sessions_user_id_fkey")
  resume    CompanyResume?      @relation(fields: [resumeId], references: [id], onDelete: SetNull, map: "interview_sessions_resume_id_fkey")
  posting   JobPosting?         @relation(fields: [postingId], references: [id], onDelete: SetNull, map: "interview_sessions_posting_id_fkey")
  questions InterviewQuestion[]
  answers   InterviewAnswer[]

  @@index([userId, updatedAt], map: "interview_sessions_user_idx")
  @@index([resumeId], map: "interview_sessions_resume_idx")
  @@map("interview_sessions")
}

/// 예상 질문 한 개. 근거(citations)는 스냅숏의 줄 id(InterviewCitation.ref)를 가리킨다.
model InterviewQuestion {
  id             String    @id
  sessionId      String    @map("session_id")
  /// 세션 안 순서(0부터).
  ord            Int
  /// InterviewQuestionCategory('line' | 'project' | 'pivot' | 'tough' | 'motivation' | 'job')
  category       String
  /// 세부 분류: project → 5단계 키, pivot → P/I/V/O/T, line → 질문 묶음 번호 등(InterviewQuestionFacet). 없으면 null.
  facet          String?
  question       String
  /// 이 질문이 확인하려는 것(화면 안내).
  intent         String
  /// InterviewCitation[](jsonb)
  citations      Json
  /// 꼬리 질문(string[], jsonb)
  followUps      Json      @map("follow_ups")
  /// InterviewQuestionStatus('new' | 'practiced' | 'skipped')
  status         String    @default("new")
  starred        Boolean   @default(false)
  attemptCount   Int       @default(0) @map("attempt_count")
  /// 완료된 피드백 중 가장 높은 종합 점수(0~100).
  bestScore      Int?      @map("best_score")
  lastAnsweredAt DateTime? @map("last_answered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "interview_questions_session_id_fkey")
  answers InterviewAnswer[]

  @@unique([sessionId, ord], map: "interview_questions_ord_uq")
  @@map("interview_questions")
}

/// 연습 답변 1회와 그 피드백. 하루 제한은 rate_events로 센다(이 표를 지워도 줄지 않게).
model InterviewAnswer {
  id          String    @id
  questionId  String    @map("question_id")
  sessionId   String    @map("session_id")
  userId      String    @map("user_id")
  answer      String
  /// 사용자가 잰 답변 시간(초, 선택).
  durationSec Int?      @map("duration_sec")
  /// InterviewAnswerStatus('pending' | 'done' | 'failed')
  status      String    @default("pending")
  /// InterviewFeedback(jsonb). done일 때만.
  feedback    Json?
  /// 종합 점수 0~100(feedback.overall). done일 때만.
  score       Int?
  error       String?
  provider    String?
  model       String?
  usage       Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "interview_answers_question_id_fkey")
  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "interview_answers_session_id_fkey")
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "interview_answers_user_id_fkey")

  @@index([questionId, createdAt], map: "interview_answers_question_idx")
  @@index([sessionId, createdAt], map: "interview_answers_session_idx")
  @@index([userId, createdAt], map: "interview_answers_user_idx")
  @@map("interview_answers")
}

/// 비용이 드는 기능의 요청 제한 원장(인스턴스 사이에 공유되는 레이트 리밋). src/lib/auth/db-rate-limit.ts.
model RateEvent {
  id        Int      @id @default(autoincrement())
  bucket    String
  key       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([bucket, key, createdAt], map: "rate_events_key_idx")
  @@map("rate_events")
}

/// LLM 호출 1건의 토큰 사용량 원장(append-only, 관리자 '사용량' 화면 — src/lib/llm/usage.ts).
/// 프롬프트·응답 본문은 저장하지 않는다(개수·모델·엔진·작업·성공 여부·시각·참조 id만). 탈퇴하면 함께 지워진다(CASCADE).
/// user_id가 null이면 사용자에 묶이지 않은 호출(시스템 작업).
model LlmUsageEvent {
  id               Int      @id @default(autoincrement())
  userId           String?  @map("user_id")
  /// 심사 단계면 'diagnosis'(단계는 stage), 아니면 LlmTask.
  task             String
  /// 심사 단계 키(StageKey). 심사 밖 호출은 null.
  stage            String?
  /// ProviderId('anthropic' | 'claude-cli' | 'codex-cli').
  provider         String
  model            String
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  /// 추정 비용(USD의 백만분의 1, 정수). 가격을 모르는 모델·CLI 엔진은 null.
  costMicroUsd     BigInt?  @map("cost_micro_usd")
  ok               Boolean
  /// 실패 사유(LlmPermanentError.reason 또는 'error'). 성공이면 null.
  errorReason      String?  @map("error_reason")
  /// 관련 행 id(진단·대화 스레드·면접 세션 등). FK 없음.
  referenceId      String?  @map("reference_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade, map: "llm_usage_events_user_id_fkey")

  @@index([userId, createdAt], map: "llm_usage_events_user_idx")
  @@index([createdAt], map: "llm_usage_events_created_idx")
  @@map("llm_usage_events")
}

/// MCP(외부 AI 앱) 접근 토큰. 원문은 만들 때 한 번만 보여 주고 DB에는 SHA-256 해시만 둔다(docs/MCP.md).
/// kind: 'pat'(사용자가 만든 개인 토큰). 'oauth'와 client_id는 OAuth 연결(2단계)용 자리다.
model McpToken {
  id         String    @id
  userId     String    @map("user_id")
  /// 사용자가 붙인 이름(예: "Claude Code").
  name       String
  /// 토큰 원문의 SHA-256(hex).
  tokenHash  String    @unique(map: "mcp_tokens_token_hash_unique") @map("token_hash")
  /// 원문 앞 12자("clp_" + 8자). 목록에서 토큰을 알아보는 데만 쓴다.
  prefix     String
  kind       String    @default("pat")
  clientId   String?   @map("client_id")
  scopes     String[]  @default(["graph:read"])
  /// 만료 시각. null이면 만료 없음.
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "mcp_tokens_user_id_fkey")

  @@index([userId, createdAt], map: "mcp_tokens_user_idx")
  @@map("mcp_tokens")
}
