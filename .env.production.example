# CareerLoop 라이브(Vercel Production) 환경 변수 템플릿.
#
# 쓰는 법
# 1) 이 파일을 .env.vercel.production 으로 복사해 값을 채운다(.env* 는 git에 올라가지 않는다. 이 템플릿만 예외).
# 2) Vercel → Project → Settings → Environment Variables → "Import .env"로 붙여넣고, 범위는 **Production만** 고른다.
#    (또는 `vercel env add <NAME> production`). '모든 환경'으로 넣으면 Preview가 운영 DB·버킷·그래프를 쓰게 된다.
# 3) 값을 바꾼 뒤에는 다시 배포해야 반영된다. 필수 값이 빠지면 Vercel 빌드가 누락 목록과 함께 실패한다.
#
# 주의: 이 파일을 .env.production(.local) 이름으로 두지 말 것 — 로컬 `next build`가 자동으로 읽어 PRODUCTION 검사에 걸린다.

# ── 배포 모드 ─────────────────────────────────────────────────────────────
APP_ENV=PRODUCTION
# 운영 도메인(https 필수). Google 리디렉션 URI·same-origin 검사가 이 주소를 쓴다.
# 비우면 https://$VERCEL_PROJECT_PRODUCTION_URL(Vercel이 정하는 기본 운영 도메인)을 쓴다.
APP_URL=https://

# ── DB: Turso(libsql) ─────────────────────────────────────────────────────
# turso db create careerloop --location aws-ap-northeast-1 → turso db show careerloop --url
# turso db tokens create careerloop. Vercel Turso 연동을 쓰면 TURSO_DATABASE_URL·TURSO_AUTH_TOKEN이 자동으로 들어가 비워도 된다.
# 마이그레이션은 Production 빌드 끝에 한 번 적용된다(빌드 로그 "[migrate] 적용 완료").
DATABASE_URL=libsql://
DATABASE_AUTH_TOKEN=

# ── AI 엔진: Claude API(Vercel에서는 필수 — CLI 엔진은 항상 꺼짐) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── 로그인: Google OAuth(가입은 Google로만) ───────────────────────────────
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: https://<운영 도메인>/api/auth/google/callback  (APP_URL과 같은 도메인)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 경력 그래프: Neo4j Aura ───────────────────────────────────────────────
# Aura 콘솔에서 인스턴스 생성(아시아 리전 권장) 후 받은 접속 정보
NEO4J_URI=neo4j+s://
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# (선택) 비우면 기본 데이터베이스
NEO4J_DATABASE=

# ── 이력서 저장소: Cloudflare R2 ──────────────────────────────────────────
# R2 → API 토큰 관리 → '객체 읽기·쓰기' 토큰을 이 버킷으로 제한해 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# (선택) 관할 구역 버킷 등 엔드포인트를 직접 지정할 때만
R2_ENDPOINT=

# ── 사용량 제한(선택, 비우면 기본값) ──────────────────────────────────────
# 사용자당 하루 진단 수(기본 5)
DAILY_DIAGNOSIS_LIMIT=5
# 사용자당 24시간 심사위원 대화 메시지 수(기본 100)
REVIEWER_CHAT_DAILY_LIMIT=
