# CareerLoop 라이브(Vercel Production) 환경 변수 템플릿.
#
# 쓰는 법
# 1) 이 파일을 .env.vercel.production 으로 복사해 값을 채운다(.env* 는 git에 올라가지 않는다. 이 템플릿만 예외).
# 2) Vercel → Project → Settings → Environment Variables → "Import .env"로 붙여넣고, 범위는 **Production만** 고른다.
#    (또는 `vercel env add <NAME> production`). '모든 환경'으로 넣으면 Preview가 운영 DB·버킷·그래프를 쓰게 된다.
# 3) 값을 바꾼 뒤에는 다시 배포해야 반영된다. 필수 값이 빠지면 Vercel 빌드가 누락 목록과 함께 실패한다.
#
# 주의: 이 파일을 .env.production(.local) 이름으로 두지 말 것 — 로컬 `next build`가 자동으로 읽어 PRODUCTION 검사에 걸린다.

# ── 배포 모드 ─────────────────────────────────────────────────────────────
APP_ENV=PRODUCTION
# 운영 도메인(https 필수). Google 리디렉션 URI·same-origin 검사가 이 주소를 쓴다.
# 비우면 https://$VERCEL_PROJECT_PRODUCTION_URL(Vercel이 정하는 기본 운영 도메인)을 쓴다.
APP_URL=https://

# ── DB: Supabase PostgreSQL(Prisma) ───────────────────────────────────────
# Supabase 프로젝트(리전 Northeast Asia (Seoul) ap-northeast-2) → 상단 Connect → ORMs(Prisma) 또는 Connection string.
# DATABASE_URL: Transaction pooler(포트 6543) — 앱 런타임(서버리스 함수)용.
# DIRECT_URL:   Session pooler(포트 5432) — 빌드 끝의 마이그레이션(prisma migrate deploy)용.
#               직접 연결(db.<ref>.supabase.co)은 IPv6 전용이라 Vercel에서 닿지 않으니 Session pooler를 쓴다.
# [PASSWORD]는 Database password(특수문자는 URL 인코딩). Vercel의 Supabase 연동을 쓰면 POSTGRES_PRISMA_URL·POSTGRES_URL·
# POSTGRES_URL_NON_POOLING이 들어와 두 값을 비워도 된다(앱이 그 값을 대신 쓴다).
# 마이그레이션은 Production 빌드 끝에 한 번 적용된다(빌드 로그 "[migrate] 적용 완료").
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── AI 엔진: Claude API(Vercel에서는 필수 — CLI 엔진은 항상 꺼짐) ──────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── 로그인: Google OAuth(가입은 Google로만) ───────────────────────────────
# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: https://<운영 도메인>/api/auth/google/callback  (APP_URL과 같은 도메인)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 경력 그래프: Neo4j(자체 호스팅 graph.example.com, TLS) ─────────────
# 맥미니에서 운영하는 Neo4j(deploy/graph/README.md). Bolt TLS 필수, 라우팅 없는 직접 연결(bolt+s).
# 비밀번호는 deploy/graph/.env의 NEO4J_PASSWORD. 공유기에서 TCP 7697 포워딩이 필요하다.
NEO4J_URI=bolt+s://graph.example.com:7697
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# (선택) 비우면 기본 데이터베이스
NEO4J_DATABASE=

# ── 이력서 저장소: Cloudflare R2 ──────────────────────────────────────────
# R2 → API 토큰 관리 → '객체 읽기·쓰기' 토큰을 이 버킷으로 제한해 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# (선택) 관할 구역 버킷 등 엔드포인트를 직접 지정할 때만
R2_ENDPOINT=

# ── 사용량 제한(선택, 비우면 기본값) ──────────────────────────────────────
# 사용자당 하루 진단 수(기본 5)
DAILY_DIAGNOSIS_LIMIT=5
# 사용자당 24시간 심사위원 대화 메시지 수(기본 100)
REVIEWER_CHAT_DAILY_LIMIT=

# ── 관리자 ─────────────────────────────────────────────────────────────
# 회원 관리(가입 승인) 권한. Google 로그인 계정 이메일, 쉼표 구분.
ADMIN_EMAILS=kicet3@gmail.com

# (선택) 에이전트 이력서 작성을 맥미니 실행기에서 실행한다(deploy/agent/README.md). 둘 다 있어야 켜진다.
# RESUME_AGENT_CHAIN_SECRET: 32자 이상(openssl rand -hex 32), 실행기와 같은 값. RESUME_AGENT_RUNNER_URL: 실행기 주소(https).
RESUME_AGENT_CHAIN_SECRET=
RESUME_AGENT_RUNNER_URL=
