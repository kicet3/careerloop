{
  "name": "careerloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build && node scripts/migrate.mjs",
    "start": "next start",
    "start:prod": "APP_ENV=PRODUCTION next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "prisma generate && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:up": "docker compose -p resume-career $([ -f .env.local ] && echo --env-file .env.local) up -d --wait postgres"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@aws-sdk/client-s3": "^3.1162.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.2",
    "neo4j-driver": "^6.3.0",
    "next": "16.4.2",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "puppeteer-core": "25.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pglite-prisma-adapter": "^0.7.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
